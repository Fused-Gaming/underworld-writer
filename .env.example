# Modal.com credentials for audio generation
# Obtain these from https://modal.com/settings/tokens after creating an account
MODAL_TOKEN_ID=your-token-id-here
MODAL_TOKEN_SECRET=your-token-secret-here

# Optional: Modal app name prefix (defaults to "underworld-audio")
# MODAL_APP_NAME=underworld-audio-prod

# Scoped npm automation token for publishing @h4shed/skill-underworld-writer
# (see docs/ops/PUBLISHING.md). Read automatically by .npmrc; falls back to
# an interactive `npm login` session when unset.
UW_NPM_TOKEN=
