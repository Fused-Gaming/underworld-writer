{
  "name": "@h4shed/skill-underworld-writer",
  "version": "1.0.25",
  "description": "Create detailed character profiles, mythologies, and narrative worlds for underworld-themed stories with PACER API integration for fact-checking editorial phases",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./mcp": "./dist/mcp-tools.js"
  },
  "bin": {
    "underworld-writer": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "cli": "node dist/cli.js",
    "test": "echo \"No tests yet\"",
    "benchmark": "npm run build && node benchmarks/utilities/benchmark-runner.js",
    "benchmark:ts": "npx ts-node benchmarks/utilities/benchmark-runner.ts",
    "benchmark:compare": "node scripts/compare-baselines.js",
    "benchmark:report": "node scripts/generate-benchmark-report.js",
    "benchmark:baseline": "npm run benchmark > benchmarks/packages/@h4shed/skill-underworld-writer/v1.0.25/baseline-results.json"
  },
  "dependencies": {
    "@h4shed/mcp-core": "^1.0.24",
    "@h4shed/cleanroom": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "typescript": "^5.3.2"
  },
  "keywords": [
    "mcp",
    "skill",
    "underworld",
    "character",
    "narrative",
    "creative-writing",
    "pacer",
    "fact-checking"
  ],
  "author": "Fused Gaming",
  "license": "Apache-2.0",
  "repository": "https://github.com/Fused-Gaming/underworld-writer",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
