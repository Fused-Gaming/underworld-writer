{
  "name": "@h4shed/skill-underworld-writer",
  "version": "2.2.1",
  "description": "Three-use-case skill for fictional underworld narratives, factually sourced true crime writing, and episodic podcast production with podcast scripting engine, character development, editorial verification, PACER API integration, and comprehensive documentation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./mcp": "./dist/mcp-tools.js",
    "./cli": "./dist/cli.js"
  },
  "bin": {
    "underworld-writer": "./dist/cli.js"
  },
  "plugin": "./plugin.json",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "cli": "node dist/cli.js",
    "test": "jest",
    "test:workspace": "node --test validation-tests/*.test.mjs",
    "test:episode1": "node scripts/editorial-package.mjs generate --series insight-corruption --season 1 --episode 1 --check",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "benchmark": "npm run build && node scripts/benchmark.js",
    "benchmark:workspace": "node scripts/benchmark.js",
    "verify-episode-claims": "node scripts/verify-episode-claims.mjs",
    "agent:preflight": "node scripts/podcast-workspace.mjs preflight",
    "podcast:new-series": "node scripts/podcast-workspace.mjs series create",
    "podcast:new-season": "node scripts/podcast-workspace.mjs season create",
    "podcast:new-episode": "node scripts/podcast-workspace.mjs episode create",
    "editorial:generate": "node scripts/editorial-package.mjs generate",
    "editorial:check": "node scripts/editorial-package.mjs generate --check",
    "validate:workspace": "node scripts/validate-output-structure.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "release:art": "node scripts/render-release-artwork.mjs",
    "release:art:check": "node scripts/render-release-artwork.mjs --check",
    "rock:validate": "npx --yes --package=@h4shed/rock-hardened@1.0.0 hardened-changelogger validate",
    "rock:evidence": "npx --yes --package=@h4shed/rock-hardened@1.0.0 hardened-changelogger ci",
    "rock:manifest": "npx --yes --package=@h4shed/rock-hardened@1.0.0 hardened-changelogger manifest",
    "validate:release": "npm run version:check && npm run validate:workspace && npm run rock:validate && npm run test:workspace && npm run test:episode1 && npm run build && npm test && npm run benchmark:workspace",
    "release:evidence": "npm run validate:release && npm run rock:evidence && npm run release:art",
    "prepublishOnly": "npm run release:evidence && npm run lint && npm run test:coverage"
  },
  "dependencies": {
    "@h4shed/mcp-core": "^1.0.40"
  },
  "optionalDependencies": {
    "@h4shed/cleanroom": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.12.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.3.2"
  },
  "keywords": [
    "mcp",
    "skill",
    "underworld",
    "character",
    "narrative",
    "creative-writing",
    "true-crime",
    "fiction",
    "journalism",
    "source-verification",
    "editorial",
    "pacer",
    "fact-checking"
  ],
  "author": "Fused Gaming",
  "license": "Apache-2.0",
  "repository": "https://github.com/Fused-Gaming/underworld-writer",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
