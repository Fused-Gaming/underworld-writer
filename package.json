{
  "name": "@h4shed/skill-underworld-writer",
  "version": "2.0.7",
  "description": "Three-use-case skill for fictional underworld narratives, factually sourced true crime writing, and episodic podcast production with podcast scripting engine, character development, editorial verification, PACER API integration, and comprehensive documentation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./mcp": "./dist/mcp-tools.js",
    "./cli": "./dist/cli.js"
  },
  "bin": {
    "underworld-writer": "./dist/cli.js"
  },
  "plugin": "./plugin.json",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "cli": "node dist/cli.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@h4shed/mcp-core": "^1.0.40"
  },
  "optionalDependencies": {
    "@h4shed/cleanroom": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.12.0",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "typescript": "^5.3.2"
  },
  "keywords": [
    "mcp",
    "skill",
    "underworld",
    "character",
    "narrative",
    "creative-writing",
    "true-crime",
    "fiction",
    "journalism",
    "source-verification",
    "editorial",
    "pacer",
    "fact-checking"
  ],
  "author": "Fused Gaming",
  "license": "Apache-2.0",
  "repository": "https://github.com/Fused-Gaming/underworld-writer",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
